{
  "layer": "top",
  "position": "top",
  "height": 42,
  "margin-top": 10,
  "margin-left": 14,
  "margin-right": 14,
  "spacing": 0,
  "fixed-center": true,
  "reload_style_on_change": true,
  "modules-left": [
    "custom/launcher",
    "hyprland/workspaces",
    "hyprland/window"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "hyprland/language",
    "pulseaudio",
    "network",
    "custom/vpn",
    "battery",
    "privacy",
    "tray",
    "custom/session"
  ],
  "custom/launcher": {
    "format": "󱄅",
    "align": 0.5,
    "justify": "center",
    "tooltip-format": "Control center\nClick to open · right-click for applications",
    "on-click": "@swaync@ --toggle-panel --skip-wait",
    "on-click-right": "@rofi@ -show drun"
  },
  "hyprland/workspaces": {
    "format": "<b>{icon}</b>{windows}",
    "format-icons": "@workspaceLabels@",
    "on-click": "activate",
    "on-scroll-up": "@hyprctl@ dispatch 'hl.dsp.focus({ workspace = \"m-1\" })'",
    "on-scroll-down": "@hyprctl@ dispatch 'hl.dsp.focus({ workspace = \"m+1\" })'",
    "all-outputs": false,
    "move-to-monitor": false,
    "sort-by": "number",
    "format-window-separator": " ",
    "window-rewrite-default": " ",
    "window-rewrite": {
      "class<kitty>": " ",
      "class<com.mitchellh.ghostty>": " ",
      "class<google-chrome>": " ",
      "class<firefox>": " ",
      "class<thunar>": " ",
      "class<.*Bazaar>": " ",
      "class<v2rayN>": " ",
      "class<org.pulseaudio.pavucontrol>": " ",
      "class<system-monitor>": " ",
      "class<network-info>": " ",
      "class<.*[Tt]elegram.*>": " ",
      "class<.*[Ss]potify.*>": " ",
      "class<code|Code|codium>": " "
    }
  },
  "hyprland/window": {
    "format": "{}",
    "separate-outputs": true,
    "max-length": 32,
    "tooltip": false,
    "icon": true,
    "icon-size": 16
  },
  "clock": {
    "format": "<span color='#@accent@'></span>  {0:%a %d %b}  <b>{0:%H:%M}</b>",
    "format-alt": "<span color='#@accent@'></span>  {0:%A, %d %B %Y}  <b>{0:%H:%M}</b>",
    "tooltip-format": "<big>{:%B %Y}</big>\n\n<tt>{calendar}</tt>\n\n<small>Click: full date · scroll: browse months\nRight-click: month / year</small>",
    "calendar": {
      "mode": "month",
      "on-scroll": 1,
      "format": {
        "today": "<span color='#@accent@'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },
  "hyprland/language": {
    "format": "<span color='#@yellow@'></span>  {}",
    "format-en": "EN",
    "format-fa": "FA",
    "on-click": "@hyprctl@ switchxkblayout all next",
    "tooltip-format": "Keyboard: {}\nClick to switch layout"
  },
  "pulseaudio": {
    "format": "<span color='#@lavender@'>{icon}</span>",
    "format-muted": "<span color='#@red@'>󰝟</span>",
    "format-icons": {
      "headphone": "󰋋",
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ]
    },
    "scroll-step": 2,
    "max-volume": 100,
    "on-click": "@pavucontrol@",
    "on-click-right": "@wpctl@ set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "tooltip-format": "{desc} · {volume}%\nClick: audio mixer · right-click: mute\nScroll: volume"
  },
  "network": {
    "interval": 5,
    "format-wifi": "<span color='#@blue@'>{icon}</span>",
    "format-ethernet": "",
    "format-linked": "<span color='#@yellow@'>󰈀</span>  No address",
    "format-disconnected": "<span color='#@red@'>󰤭</span>  Offline",
    "format-icons": [
      "󰤯",
      "󰤟",
      "󰤢",
      "󰤥",
      "󰤨"
    ],
    "max-length": 16,
    "tooltip-format": "{ifname} · {ipaddr}/{cidr}\n↓ {bandwidthDownBytes}  ↑ {bandwidthUpBytes}\n\nClick: network menu · middle-click: addresses · right-click: routes",
    "tooltip-format-wifi": "{essid} · signal {signalStrength}%\n{ifname} · {ipaddr}/{cidr}\n↓ {bandwidthDownBytes}  ↑ {bandwidthUpBytes}\n\nClick: network menu · middle-click: addresses · right-click: routes",
    "tooltip-format-disconnected": "No network connection\nClick: network menu · middle-click: interfaces",
    "on-click": "@networkMenu@",
    "on-click-middle": "@kitty@ --hold --class network-info @ip@ -color -brief address",
    "on-click-right": "@kitty@ --hold --class network-info @ip@ -color route"
  },
  "custom/vpn": {
    "exec": "@vpnStatus@ --watch",
    "return-type": "json",
    "restart-interval": 5,
    "on-click": "@networkMenu@",
    "max-length": 18
  },
  "battery": {
    "interval": 30,
    "states": {
      "warning": 25,
      "critical": 10
    },
    "format": "{icon}  {capacity}%",
    "format-charging": "󰂄  {capacity}%",
    "format-plugged": "󰚥  {capacity}%",
    "format-icons": [
      "󰁺",
      "󰁼",
      "󰁾",
      "󰂀",
      "󰁹"
    ],
    "tooltip-format": "{capacity}% · {timeTo} · {power:.1f} W"
  },
  "privacy": {
    "icon-spacing": 6,
    "icon-size": 14,
    "modules": [
      {
        "type": "screenshare"
      },
      {
        "type": "audio-in"
      }
    ]
  },
  "tray": {
    "icon-size": 16,
    "spacing": 8
  },
  "custom/session": {
    "format": "⏻",
    "tooltip-format": "Session\nLock · suspend · log out · restart · shut down",
    "menu": "on-click",
    "menu-file": "@sessionMenu@",
    "menu-actions": {
      "lock": "@hyprlock@",
      "suspend": "@systemctl@ suspend",
      "logout": "@hyprctl@ dispatch 'hl.dsp.exit()'",
      "reboot": "@systemctl@ reboot",
      "shutdown": "@systemctl@ poweroff"
    }
  }
}
