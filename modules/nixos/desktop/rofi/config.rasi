configuration {
    modes: "drun";
    show-icons: true;
    drun-display-format: "{name}";
    display-drun: "Applications";
    matching: "fuzzy";
    sort: true;
    terminal: "kitty";
    font: "JetBrainsMono Nerd Font 12";
}

* {
    background: #@base@;
    surface: #@surface@;
    border: #@border@;
    foreground: #@text@;
    muted: #@muted@;
    accent: #@accent@;

    background-color: transparent;
    text-color: @foreground;
    spacing: 0;
}

window {
    width: 42%;
    border: 2px;
    border-color: @accent;
    border-radius: 14px;
    background-color: @background;
    padding: 18px;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 14px;
}

inputbar {
    children: [ prompt, entry ];
    background-color: @surface;
    border: 1px;
    border-color: @border;
    border-radius: 10px;
    padding: 12px 14px;
    spacing: 10px;
}

prompt {
    text-color: @accent;
}

entry {
    placeholder: "Search applications";
    placeholder-color: @muted;
}

listview {
    columns: 1;
    lines: 8;
    fixed-height: false;
    scrollbar: false;
    spacing: 5px;
}

element {
    border-radius: 9px;
    padding: 9px 11px;
    spacing: 12px;
}

element normal.normal,
element alternate.normal,
element normal.urgent,
element alternate.urgent,
element normal.active,
element alternate.active {
    background-color: transparent;
    text-color: @foreground;
}

element selected.normal,
element selected.urgent,
element selected.active {
    background-color: @surface;
    text-color: @accent;
}

element-icon {
    size: 28px;
    background-color: transparent;
}

element-text {
    vertical-align: 0.5;
    background-color: transparent;
}
